        <bpmndi:BPMNLabel>
          <dc:Bounds x="2781" y="506" width="69" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Moderated_di" bpmnElement="End_Moderated">
        <dc:Bounds x="2940" y="455" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2905" y="495" width="107" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Logged_di" bpmnElement="Gateway_Logged" isMarkerVisible="true">
        <dc:Bounds x="565" y="360" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="546" y="415" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Login_di" bpmnElement="Task_Login">
        <dc:Bounds x="690" y="345" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Write_di" bpmnElement="Task_Write">
        <dc:Bounds x="870" y="345" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Tags_di" bpmnElement="Task_Tags">
        <dc:Bounds x="1030" y="345" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Solved_di" bpmnElement="End_Solved">
        <dc:Bounds x="2222" y="235" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2211" y="275" width="59" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Accept_di" bpmnElement="Task_Accept">
        <dc:Bounds x="2060" y="213" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Solved_di" bpmnElement="Gateway_Solved" isMarkerVisible="true">
        <dc:Bounds x="1925" y="228" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1897" y="190.5" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_CorrectionRequest_di" bpmnElement="Catch_CorrectionRequest">
        <dc:Bounds x="1962" y="367" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1932" y="343" width="95" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Existing_di" bpmnElement="End_Existing">
        <dc:Bounds x="732" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="721" y="222" width="59" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_U01_di" bpmnElement="Flow_U01">
        <di:waypoint x="266" y="298" />
        <di:waypoint x="300" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U02_di" bpmnElement="Flow_U02">
        <di:waypoint x="420" y="298" />
        <di:waypoint x="460" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U03_di" bpmnElement="Flow_U03">
        <di:waypoint x="485" y="273" />
        <di:waypoint x="485" y="200" />
        <di:waypoint x="550" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="513" y="180" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U04_di" bpmnElement="Flow_U04">
        <di:waypoint x="675" y="200" />
        <di:waypoint x="732" y="200" />
