<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_StackOverflow_Final" targetNamespace="https://unb.br/bpmn/stackoverflow/final" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.25.1">
  <bpmn:message id="Message_Question" name="Pergunta publicada" />
  <bpmn:message id="Message_Answer" name="Resposta publicada" />
  <bpmn:message id="Message_CorrectionRequest" name="Correção solicitada" />
  <bpmn:message id="Message_Correction" name="Pergunta corrigida" />
  <bpmn:message id="Message_ModerationResult" name="Resultado da moderação" />
  <bpmn:collaboration id="Collaboration_StackOverflow_Final">
    <bpmn:participant id="Participant_User" name="Usuário" processRef="Process_User" />
    <bpmn:participant id="Participant_StackOverflow" name="Forum" processRef="Process_StackOverflow" />
    <bpmn:participant id="Participant_1jey8vc" name="Usuário" processRef="Process_0ax89kt" />
    <bpmn:participant id="Participant_0vtm4nt" name="Fórum" processRef="Process_0ff7j37" />
    <bpmn:messageFlow id="MessageFlow_Question" sourceRef="Send_Question" targetRef="Start_Question" />
    <bpmn:messageFlow id="MessageFlow_Answer" name="Resposta publicada" sourceRef="Send_Answer" targetRef="Catch_Answer" />
    <bpmn:messageFlow id="MessageFlow_CorrectionRequest" name="Solicitação de correção" sourceRef="Send_RequestCorrection" targetRef="Catch_CorrectionRequest" />
    <bpmn:messageFlow id="MessageFlow_Correction" name="Pergunta corrigida" sourceRef="Send_Correction" targetRef="Catch_Correction" />
    <bpmn:messageFlow id="MessageFlow_Approved" name="Publicação mantida" sourceRef="Send_Approval" targetRef="Catch_ModerationResult" />
    <bpmn:messageFlow id="MessageFlow_Decision" name="Publicação fechada ou removida" sourceRef="Send_Decision" targetRef="Catch_ModerationResult" />
    <bpmn:messageFlow id="MessageFlow_Kept" name="Publicação mantida" sourceRef="Send_KeepPublication" targetRef="Catch_ModerationResult" />
    <bpmn:messageFlow id="Flow_03xezyq" sourceRef="Send_Question" targetRef="Event_0m6kl6i" />
    <bpmn:messageFlow id="Flow_18nhn7t" sourceRef="Task_Reevaluate" targetRef="Event_0030tuz" />
    <bpmn:textAnnotation id="TextAnnotation_Inclusive">
      <bpmn:text>Gateway inclusivo: a comunidade pode responder, sinalizar ou realizar as duas ações.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Inclusive" sourceRef="Gateway_CommunityAction" targetRef="TextAnnotation_Inclusive" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" name="Participação do usuário" isExecutable="false">
    <bpmn:documentation>O usuário pesquisa conteúdo existente, autentica-se quando necessário, publica a pergunta e reage às respostas ou à moderação.</bpmn:documentation>
    <bpmn:startEvent id="Start_Doubt" name="Dúvida técnica identificada" />
    <bpmn:userTask id="Task_Search" name="Pesquisa perguntas existentes" />
    <bpmn:exclusiveGateway id="Gateway_Found" name="Encontra pergunta semelhante?" />
    <bpmn:userTask id="Task_Consult" name="Consulta respostas existentes" />
    <bpmn:exclusiveGateway id="Gateway_Logged" name="Está autenticado?">
      <bpmn:incoming>Flow_U05</bpmn:incoming>
      <bpmn:outgoing>Flow_U06</bpmn:outgoing>
      <bpmn:outgoing>Flow_03skmfd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Login" name="Realiza login">
      <bpmn:incoming>Flow_U06</bpmn:incoming>
      <bpmn:outgoing>Flow_0cn2zot</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Write" name="Redige pergunta">
      <bpmn:incoming>Flow_03skmfd</bpmn:incoming>
      <bpmn:incoming>Flow_0cn2zot</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Tags" name="Informa tags">
      <bpmn:incoming>Flow_1wrcp2l</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Existing" name="Dúvida solucionada" />
    <bpmn:startEvent id="Event_0m6kl6i" name="continua">
      <bpmn:outgoing>Flow_1wrcp2l</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_U01" sourceRef="Start_Doubt" targetRef="Task_Search" />
    <bpmn:sequenceFlow id="Flow_U02" sourceRef="Task_Search" targetRef="Gateway_Found" />
    <bpmn:sequenceFlow id="Flow_U03" name="Sim" sourceRef="Gateway_Found" targetRef="Task_Consult">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">perguntaSemelhanteEncontrada</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_U05" name="Não" sourceRef="Gateway_Found" targetRef="Gateway_Logged" />
    <bpmn:sequenceFlow id="Flow_U04" sourceRef="Task_Consult" targetRef="End_Existing" />
    <bpmn:sequenceFlow id="Flow_U06" name="Não" sourceRef="Gateway_Logged" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="Flow_03skmfd" name="Sim" sourceRef="Gateway_Logged" targetRef="Task_Write" />
    <bpmn:sequenceFlow id="Flow_0cn2zot" sourceRef="Task_Login" targetRef="Task_Write" />
    <bpmn:sequenceFlow id="Flow_U10" sourceRef="Task_Write" targetRef="Task_Tags" />
    <bpmn:sequenceFlow id="Flow_1wrcp2l" sourceRef="Event_0m6kl6i" targetRef="Task_Tags" />
  </bpmn:process>
  <bpmn:process id="Process_StackOverflow" name="Participação da comunidade e moderação" isExecutable="false">
    <bpmn:documentation>A piscina Stack Overflow contém dois papéis internos. A comunidade responde ou sinaliza; o moderador ou usuário confiável analisa as exceções.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_StackOverflow">
      <bpmn:lane id="Lane_Moderator" name="Moderador / Usuário confiável">
        <bpmn:flowNodeRef>Task_KeepPublication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_KeepPublication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Correctable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Correction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_FlagClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewFlag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Violation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_RequestCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0030tuz</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Community" name="Comunidade">
        <bpmn:flowNodeRef>Start_Question</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeQuestion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CommunityAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DraftAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FlagContent</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Question" name="Pergunta recebida">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Question" messageRef="Message_Question" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_AnalyzeQuestion" name="Analisa pergunta" />
    <bpmn:inclusiveGateway id="Gateway_CommunityAction" name="Quais ações realiza?" />
    <bpmn:userTask id="Task_DraftAnswer" name="Elabora resposta" />
    <bpmn:sendTask id="Send_Answer" name="Publica resposta" />
    <bpmn:endEvent id="End_Answer" name="Resposta disponibilizada" />
    <bpmn:userTask id="Task_FlagContent" name="Sinaliza conteúdo" />
    <bpmn:userTask id="Task_KeepPublication" name="Mantém publicação" />
    <bpmn:sendTask id="Send_KeepPublication" name="Informa que sinalização não procedeu" />
    <bpmn:exclusiveGateway id="Gateway_Correctable" name="Problema pode ser corrigido?" />
    <bpmn:intermediateCatchEvent id="Catch_Correction" name="Correção recebida">
      <bpmn:incoming>Flow_09fzsvl</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Correction" messageRef="Message_Correction" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_FlagClosed" name="Sinalização encerrada" />
    <bpmn:userTask id="Task_ReviewFlag" name="Analisa sinalização" />
    <bpmn:exclusiveGateway id="Gateway_Violation" name="Conteúdo viola regras?" default="Flow_S09" />
    <bpmn:sendTask id="Send_RequestCorrection" name="Solicita correção ao autor" />
    <bpmn:startEvent id="Event_0030tuz" name="Continua">
      <bpmn:outgoing>Flow_09fzsvl</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S01" sourceRef="Start_Question" targetRef="Task_AnalyzeQuestion" />
    <bpmn:sequenceFlow id="Flow_S02" sourceRef="Task_AnalyzeQuestion" targetRef="Gateway_CommunityAction" />
    <bpmn:sequenceFlow id="Flow_S03" name="Responder" sourceRef="Gateway_CommunityAction" targetRef="Task_DraftAnswer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">podeResponder</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S06" name="Sinalizar" sourceRef="Gateway_CommunityAction" targetRef="Task_FlagContent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">deveSinalizar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S04" sourceRef="Task_DraftAnswer" targetRef="Send_Answer" />
    <bpmn:sequenceFlow id="Flow_S05" sourceRef="Send_Answer" targetRef="End_Answer" />
    <bpmn:sequenceFlow id="Flow_S07" sourceRef="Task_FlagContent" targetRef="Task_ReviewFlag" />
    <bpmn:sequenceFlow id="Flow_S09" name="Não" sourceRef="Gateway_Violation" targetRef="Task_KeepPublication" />
    <bpmn:sequenceFlow id="Flow_S10" sourceRef="Task_KeepPublication" targetRef="Send_KeepPublication" />
    <bpmn:sequenceFlow id="Flow_S10b" sourceRef="Send_KeepPublication" targetRef="End_FlagClosed" />
    <bpmn:sequenceFlow id="Flow_S11" name="Sim" sourceRef="Gateway_Violation" targetRef="Gateway_Correctable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">violaRegras</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S12" name="Sim" sourceRef="Gateway_Correctable" targetRef="Send_RequestCorrection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">podeSerCorrigido</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S14" sourceRef="Send_RequestCorrection" targetRef="Catch_Correction" />
    <bpmn:sequenceFlow id="Flow_09fzsvl" sourceRef="Event_0030tuz" targetRef="Catch_Correction" />
    <bpmn:sequenceFlow id="Flow_S08" sourceRef="Task_ReviewFlag" targetRef="Gateway_Violation" />
  </bpmn:process>
  <bpmn:process id="Process_0ax89kt">
    <bpmn:sendTask id="Send_Question" name="Publica pergunta" />
    <bpmn:eventBasedGateway id="Gateway_WaitFeedback" name="Aguarda retorno" />
    <bpmn:intermediateCatchEvent id="Catch_Answer" name="Resposta recebida">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Answer" messageRef="Message_Answer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Evaluate" name="Avalia resposta" />
    <bpmn:userTask id="Task_Edit" name="Corrige pergunta" />
    <bpmn:sendTask id="Send_Correction" name="Reenvia pergunta corrigida" />
    <bpmn:endEvent id="End_Solved" name="Dúvida solucionada" />
    <bpmn:userTask id="Task_Accept" name="Aceita resposta" />
    <bpmn:exclusiveGateway id="Gateway_Solved" name="Resposta soluciona a dúvida?" default="Flow_U20" />
    <bpmn:intermediateCatchEvent id="Catch_CorrectionRequest" name="Correção solicitada">
      <bpmn:messageEventDefinition id="MessageEventDefinition_CorrectionRequest" messageRef="Message_CorrectionRequest" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_ModerationResult" name="Resultado recebido">
      <bpmn:messageEventDefinition id="MessageEventDefinition_ModerationResult" messageRef="Message_ModerationResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Kept" name="Publicação foi mantida?" default="Flow_U24" />
    <bpmn:endEvent id="End_Moderated" name="Publicação encerrada pela moderação" />
    <bpmn:sequenceFlow id="Flow_U12" sourceRef="Send_Question" targetRef="Gateway_WaitFeedback" />
    <bpmn:sequenceFlow id="Flow_U20" name="Não" sourceRef="Gateway_Solved" targetRef="Gateway_WaitFeedback" />
    <bpmn:sequenceFlow id="Flow_U23" sourceRef="Send_Correction" targetRef="Gateway_WaitFeedback" />
    <bpmn:sequenceFlow id="Flow_U26" name="Sim" sourceRef="Gateway_Kept" targetRef="Gateway_WaitFeedback">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">publicacaoMantida</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_U13" sourceRef="Gateway_WaitFeedback" targetRef="Catch_Answer" />
    <bpmn:sequenceFlow id="Flow_U14" sourceRef="Gateway_WaitFeedback" targetRef="Catch_CorrectionRequest" />
    <bpmn:sequenceFlow id="Flow_U15" sourceRef="Gateway_WaitFeedback" targetRef="Catch_ModerationResult" />
    <bpmn:sequenceFlow id="Flow_U16" sourceRef="Catch_Answer" targetRef="Task_Evaluate" />
    <bpmn:sequenceFlow id="Flow_U17" sourceRef="Task_Evaluate" targetRef="Gateway_Solved" />
    <bpmn:sequenceFlow id="Flow_U21" sourceRef="Catch_CorrectionRequest" targetRef="Task_Edit" />
    <bpmn:sequenceFlow id="Flow_U22" sourceRef="Task_Edit" targetRef="Send_Correction" />
    <bpmn:sequenceFlow id="Flow_U19" sourceRef="Task_Accept" targetRef="End_Solved" />
    <bpmn:sequenceFlow id="Flow_U18" name="Sim" sourceRef="Gateway_Solved" targetRef="Task_Accept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">duvidaSolucionada</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_U25" sourceRef="Catch_ModerationResult" targetRef="Gateway_Kept" />
    <bpmn:sequenceFlow id="Flow_U24" name="Não" sourceRef="Gateway_Kept" targetRef="End_Moderated" />
  </bpmn:process>
  <bpmn:process id="Process_0ff7j37">
    <bpmn:exclusiveGateway id="Gateway_Adequate" name="Correção está adequada?" default="Flow_1ednkew">
      <bpmn:outgoing>Flow_1ednkew</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Reevaluate" name="Reavalia correção" />
    <bpmn:endEvent id="End_Approved" name="Correção aprovada" />
    <bpmn:sendTask id="Send_Approval" name="Informa manutenção da publicação" />
    <bpmn:endEvent id="End_Closed" name="Moderação concluída" />
    <bpmn:sendTask id="Send_Decision" name="Notifica decisão ao autor" />
    <bpmn:userTask id="Task_CloseOrRemove" name="Fecha ou remove publicação">
      <bpmn:incoming>Flow_1ednkew</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_S16" sourceRef="Task_Reevaluate" targetRef="Gateway_Adequate" />
    <bpmn:sequenceFlow id="Flow_S17" name="Sim" sourceRef="Gateway_Adequate" targetRef="Send_Approval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">correcaoAdequada</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ednkew" name="Não" sourceRef="Gateway_Adequate" targetRef="Task_CloseOrRemove" />
    <bpmn:sequenceFlow id="Flow_S19" sourceRef="Send_Approval" targetRef="End_Approved" />
    <bpmn:sequenceFlow id="Flow_S22" sourceRef="Send_Decision" targetRef="End_Closed" />
    <bpmn:sequenceFlow id="Flow_S21" sourceRef="Task_CloseOrRemove" targetRef="Send_Decision" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_StackOverflow_Final">
    <bpmndi:BPMNPlane id="BPMNPlane_StackOverflow_Final" bpmnElement="Collaboration_StackOverflow_Final">
