      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1wrcp2l_di" bpmnElement="Flow_1wrcp2l">
        <di:waypoint x="1262" y="325" />
        <di:waypoint x="1150" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Participant_StackOverflow_di" bpmnElement="Participant_StackOverflow" isHorizontal="true">
        <dc:Bounds x="160" y="1100" width="1230" height="600" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Moderator_di" bpmnElement="Lane_Moderator" isHorizontal="true">
        <dc:Bounds x="190" y="1350" width="1200" height="350" />
